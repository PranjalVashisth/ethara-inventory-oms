server {
  listen 8080;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # Configurable API upstream so the frontend image can run:
  # - in docker-compose (API_UPSTREAM=http://backend:8000)
  # - standalone (API_UPSTREAM=http://host.docker.internal:8000)
  location /api/ {
    proxy_pass ${API_UPSTREAM}/api/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}

